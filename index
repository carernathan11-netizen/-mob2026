<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MOB'2026 — Info Manifs & Mobilisations en Direct</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            red: '#FF3B30',
                            amber: '#FF9500',
                            dark: '#0D0F12',
                            card: '#161920',
                            border: '#262B36'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass-panel {
            background: rgba(22, 25, 32, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .pulse-red {
            box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7);
            animation: pulse-red 2s infinite;
        }
        @keyframes pulse-red {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(255, 59, 48, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 59, 48, 0); }
        }
    </style>
</head>
<body class="bg-brand-dark text-slate-100 font-sans antialiased selection:bg-brand-red selection:text-white min-h-screen flex flex-col">

    <!-- BANDEROLLE FLASH INFO -->
    <div class="bg-brand-red/10 border-b border-brand-red/30 py-2.5 px-4 text-xs md:text-sm font-medium text-red-400">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 overflow-hidden">
            <div class="flex items-center gap-2 shrink-0">
                <span class="w-2.5 h-2.5 rounded-full bg-brand-red pulse-red"></span>
                <span class="font-bold tracking-wider uppercase text-brand-red">FLASH INFO</span>
            </div>
            <div class="truncate text-slate-300">
                <span id="flash-text">Appels à rassemblements pour le 24 octobre : la carte des villes actualisée en temps réel.</span>
            </div>
            <span class="text-slate-500 text-xs shrink-0 hidden sm:inline">Mise à jour à l'instant</span>
        </div>
    </div>

    <!-- NAVBAR -->
    <header class="sticky top-0 z-50 glass-panel border-b border-brand-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-red to-brand-amber flex items-center justify-center font-black text-xl text-white shadow-lg shadow-brand-red/20">
                    M
                </div>
                <div>
                    <a href="#" class="font-extrabold text-xl tracking-tight text-white flex items-center gap-1.5">
                        MOB<span class="text-brand-red">'26</span>
                    </a>
                    <p class="text-[10px] text-slate-400 tracking-wider uppercase -mt-1 font-semibold">Live Social Tracker</p>
                </div>
            </div>

            <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
                <a href="#direct" class="hover:text-white transition flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span> Direct
                </a>
                <a href="#villes" class="hover:text-white transition">Villes & Cartes</a>
                <a href="#dossier-24oct" class="hover:text-white transition">Spécial 24 Octobre</a>
                <a href="#conseils" class="hover:text-white transition">Droits & Conseils</a>
            </nav>

            <button class="bg-brand-red hover:bg-red-600 text-white font-semibold text-xs uppercase tracking-wider py-2 px-4 rounded-lg shadow-lg shadow-brand-red/25 transition">
                <i class="fa-solid fa-plus-circle mr-1.5"></i> Signaler une manif
            </button>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">

        <!-- HERO / À LA UNE -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Article Principal à la une -->
            <div class="lg:col-span-2 relative rounded-2xl overflow-hidden glass-panel border border-brand-border p-6 md:p-8 flex flex-col justify-between group">
                <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/60 to-transparent z-10"></div>
                <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1572949645841-094f3a9c4c94?q=80&w=1200')] bg-cover bg-center group-hover:scale-105 transition duration-700 opacity-40"></div>

                <div class="relative z-20 space-y-3">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="bg-brand-red text-white text-[11px] font-extrabold uppercase px-2.5 py-1 rounded-md tracking-wider">
                            À LA UNE
                        </span>
                        <span class="bg-slate-800/80 backdrop-blur-md text-slate-300 text-xs font-medium px-2.5 py-1 rounded-md border border-slate-700">
                            24 Octobre 2026
                        </span>
                    </div>
                    <h1 class="text-2xl md:text-4xl font-black text-white leading-tight">
                        Acte II du 24 Octobre : Quels sont les rendez-vous et blocages annoncés en France ?
                    </h1>
                </div>

                <div class="relative z-20 pt-6 mt-6 border-t border-slate-700/50 flex items-center justify-between text-xs text-slate-400">
                    <span class="flex items-center gap-2 font-medium text-slate-300">
                        <i class="fa-regular fa-clock text-brand-red"></i> Mis à jour il y a 12 minutes
                    </span>
                    <a href="#dossier-24oct" class="text-brand-red font-bold hover:underline flex items-center gap-1">
                        Lire le dossier complet <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Stats Rapides & Alertes -->
            <div class="space-y-4">
                <div class="glass-panel p-5 rounded-2xl border border-brand-border space-y-4">
                    <h2 class="text-sm font-bold text-slate-400 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-chart-line text-brand-amber"></i> En chiffres (Prévisions)
                    </h2>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-brand-dark/60 p-3 rounded-xl border border-slate-800">
                            <span class="text-2xl font-black text-white block">35+</span>
                            <span class="text-[11px] text-slate-400 font-medium">Villes mobilisées</span>
                        </div>
                        <div class="bg-brand-dark/60 p-3 rounded-xl border border-slate-800">
                            <span class="text-2xl font-black text-brand-amber block">Lycéens</span>
                            <span class="text-[11px] text-slate-400 font-medium">Appels aux blocus</span>
                        </div>
                    </div>
                </div>

                <!-- Box Alerte Réseaux -->
                <div class="glass-panel p-5 rounded-2xl border border-brand-border space-y-3 bg-gradient-to-br from-brand-card to-slate-900">
                    <div class="flex items-center gap-2 text-brand-amber font-bold text-sm">
                        <i class="fa-solid fa-triangle-exclamation"></i> État des déclarations
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        De nombreux appels restent décentralisés sur les réseaux sociaux. Vérifiez le statut préfectoral de votre ville avant déplacement.
                    </p>
                </div>
            </div>
        </section>

        <!-- FIL D'ACTUALITÉ EN DIRECT (LIVE FEED) -->
        <section id="direct" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-6">
                <!-- Header Section -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-brand-border">
                    <div class="flex items-center gap-3">
                        <span class="relative flex h-3 w-3">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                        </span>
                        <h2 class="text-xl font-bold text-white">Fil d'actualité en direct</h2>
                    </div>

                    <!-- Filtres -->
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-2 sm:pb-0">
                        <button class="bg-brand-red text-white text-xs font-bold px-3 py-1.5 rounded-lg shrink-0">Tous</button>
                        <button class="bg-brand-card hover:bg-slate-800 text-slate-400 text-xs font-medium px-3 py-1.5 rounded-lg border border-brand-border shrink-0">Lycéens</button>
                        <button class="bg-brand-card hover:bg-slate-800 text-slate-400 text-xs font-medium px-3 py-1.5 rounded-lg border border-brand-border shrink-0">Gilets Jaunes</button>
                        <button class="bg-brand-card hover:bg-slate-800 text-slate-400 text-xs font-medium px-3 py-1.5 rounded-lg border border-brand-border shrink-0">Transport</button>
                    </div>
                </div>

                <!-- Timeline des événements -->
                <div class="space-y-4">

                    <!-- Post Live 1 -->
                    <article class="glass-panel p-5 rounded-2xl border border-brand-border space-y-3 hover:border-slate-700 transition">
                        <div class="flex items-center justify-between text-xs">
                            <span class="flex items-center gap-1.5 text-emerald-400 font-semibold bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
                                <i class="fa-solid fa-bolt"></i> EN COURS
                            </span>
                            <span class="text-slate-500 font-mono">11:30</span>
                        </div>
                        <h3 class="font-bold text-base text-white">Appels aux assemblées générales lycéennes ce jeudi</h3>
                        <p class="text-xs text-slate-300 leading-relaxed">
                            Plusieurs syndicats lycéens et étudiants appellent à des AG de préparation avant la journée de mobilisation nationale. Des rassemblements devant les établissements sont envisagés dans plusieurs métropoles.
                        </p>
                        <div class="flex items-center gap-3 pt-2 text-[11px] text-slate-500">
                            <span><i class="fa-solid fa-location-dot text-brand-red"></i> National</span>
                            <span>•</span>
                            <span>Éducation / Jeunesse</span>
                        </div>
                    </article>

                    <!-- Post Live 2 -->
                    <article class="glass-panel p-5 rounded-2xl border border-brand-border space-y-3 hover:border-slate-700 transition">
                        <div class="flex items-center justify-between text-xs">
                            <span class="flex items-center gap-1.5 text-brand-amber font-semibold bg-brand-amber/10 px-2.5 py-0.5 rounded-full border border-brand-amber/20">
                                <i class="fa-solid fa-map-pin"></i> PREVISION
                            </span>
                            <span class="text-slate-500 font-mono">10:15</span>
                        </div>
                        <h3 class="font-bold text-base text-white">Point de situation à Lorient & Bretagne</h3>
                        <p class="text-xs text-slate-300 leading-relaxed">
                            À Lorient, aucun cortège officiel n'est déclaré pour le moment en préfecture pour le 24 octobre. L'attention reste portée sur les événements culturels prévus (Festival Insolent à Lanester).
                        </p>
                        <div class="flex items-center gap-3 pt-2 text-[11px] text-slate-500">
                            <span><i class="fa-solid fa-location-dot text-brand-red"></i> Lorient / Lanester</span>
                            <span>•</span>
                            <span>Bretagne</span>
                        </div>
                    </article>

                    <!-- Post Live 3 -->
                    <article class="glass-panel p-5 rounded-2xl border border-brand-border space-y-3 hover:border-slate-700 transition">
                        <div class="flex items-center justify-between text-xs">
                            <span class="flex items-center gap-1.5 text-slate-400 font-semibold bg-slate-800 px-2.5 py-0.5 rounded-full">
                                <i class="fa-solid fa-bullhorn"></i> COMMUNIQUÉ
                            </span>
                            <span class="text-slate-500 font-mono">09:00</span>
                        </div>
                        <h3 class="font-bold text-base text-white">Consignes de sécurité & Rappel juridique</h3>
                        <p class="text-xs text-slate-300 leading-relaxed">
                            Rappel : L'article R. 645-14 du Code pénal punit le fait de dissimuler son visage lors de manifestations. Pensez à vos papiers d'identité et gardez du sérum physiologique avec vous.
                        </p>
                        <div class="flex items-center gap-3 pt-2 text-[11px] text-slate-500">
                            <span><i class="fa-solid fa-shield-halved text-brand-amber"></i> Prévention</span>
                        </div>
                    </article>

                </div>
            </div>

            <!-- SIDEBAR : CARTES & VILLES CONCERNÉES -->
            <aside id="villes" class="space-y-6">
                <div class="glass-panel p-5 rounded-2xl border border-brand-border space-y-4">
                    <h2 class="text-base font-bold text-white flex items-center justify-between">
                        <span><i class="fa-solid fa-city text-brand-red mr-2"></i> Suivi par Villes</span>
                        <span class="text-xs text-slate-500 font-normal">24 Oct.</span>
                    </h2>

                    <!-- Liste des villes -->
                    <div class="space-y-2.5 text-xs">
                        <div class="flex items-center justify-between p-3 rounded-xl bg-brand-dark/50 border border-slate-800">
                            <div>
                                <span class="font-bold text-white block">Paris</span>
                                <span class="text-slate-500">Place de la République / Bastille</span>
                            </div>
                            <span class="px-2 py-1 rounded bg-brand-red/20 text-red-400 font-bold text-[10px]">Appel fort</span>
                        </div>

                        <div class="flex items-center justify-between p-3 rounded-xl bg-brand-dark/50 border border-slate-800">
                            <div>
                                <span class="font-bold text-white block">Rennes</span>
                                <span class="text-slate-500">Place de la Mairie</span>
                            </div>
                            <span class="px-2 py-1 rounded bg-brand-amber/20 text-amber-400 font-bold text-[10px]">En attente</span>
                        </div>

                        <div class="flex items-center justify-between p-3 rounded-xl bg-brand-dark/50 border border-slate-800">
                            <div>
                                <span class="font-bold text-white block">Nantes</span>
                                <span class="text-slate-500">Miroir d'eau / Commerce</span>
                            </div>
                            <span class="px-2 py-1 rounded bg-brand-amber/20 text-amber-400 font-bold text-[10px]">En attente</span>
                        </div>

                        <div class="flex items-center justify-between p-3 rounded-xl bg-brand-dark/50 border border-slate-800">
                            <div>
                                <span class="font-bold text-white block">Lorient</span>
                                <span class="text-slate-500">Centre-ville / UBS</span>
                            </div>
                            <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-bold text-[10px]">R.A.S.</span>
                        </div>
                    </div>
                </div>

                <!-- Newsletter / Alerte SMS -->
                <div class="glass-panel p-5 rounded-2xl border border-brand-border space-y-3 bg-gradient-to-b from-brand-red/10 to-transparent">
                    <h3 class="font-bold text-sm text-white"><i class="fa-regular fa-bell text-brand-red mr-1.5"></i> Recevoir les alertes</h3>
                    <p class="text-xs text-slate-400">Restez informé en direct dès qu'un rassemblement est confirmé dans votre ville.</p>
                    <div class="space-y-2">
                        <input type="email" placeholder="Votre email..." class="w-full bg-brand-dark border border-brand-border rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-brand-red">
                        <button class="w-full bg-brand-red hover:bg-red-600 text-white font-bold text-xs py-2 rounded-lg transition">S'abonner</button>
                    </div>
                </div>
            </aside>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="mt-auto border-t border-brand-border bg-brand-dark py-8 text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
            <div>
                <p class="font-bold text-slate-400">MOB'2026 — Plateforme d'information citoyenne</p>
                <p class="text-[11px] text-slate-600">Site indépendant de suivi de l'actualité des mouvements sociaux.</p>
            </div>
            <div class="flex gap-4">
                <a href="#conseils" class="hover:text-slate-300">Mentions légales</a>
                <a href="#conseils" class="hover:text-slate-300">Charte de modération</a>
                <a href="#conseils" class="hover:text-slate-300">Contact</a>
            </div>
        </div>
    </footer>

</body>
</html>
